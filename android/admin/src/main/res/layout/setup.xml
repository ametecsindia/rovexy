<?xml version="1.0" encoding="utf-8"?>
<!-- First run (and "Change company"): where the console lives. Cloud = rovexy.app + workspace; on-prem = the client's server, workspace blank. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F4F6FA" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp">
        <ImageView android:layout_width="240dp" android:layout_height="70dp" android:layout_marginTop="48dp"
            android:src="@drawable/rovexy_logo" android:contentDescription="ROVEXY" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Admin console" android:textColor="@color/gold" android:textSize="16sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp"
            android:orientation="vertical" android:padding="20dp" android:background="@android:color/white" android:elevation="3dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Server address" android:textColor="#41506A" android:textSize="13sp" />
            <EditText android:id="@+id/server" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textUri" android:hint="rovexy.app" android:importantForAutofill="no" android:singleLine="true" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="Company workspace" android:textColor="#41506A" android:textSize="13sp" />
            <EditText android:id="@+id/workspace" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textNoSuggestions" android:hint="e.g. shree-recovery" android:importantForAutofill="no" android:singleLine="true" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="On rovexy.app: the workspace from your console address (rovexy.app/w/WORKSPACE/admin). Your own server: leave it empty."
                android:textColor="#6B7789" android:textSize="12sp" />
            <TextView android:id="@+id/error" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textColor="#B42318" android:textSize="13sp" android:visibility="gone" />
            <Button android:id="@+id/open" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="Open console" android:backgroundTint="@color/navy" android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
