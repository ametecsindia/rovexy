# ── ROVEXY on-premises — settings for THIS server ─────────────────────────────────────────────────
# install copies this file to rovexy\.env. Change the lines marked CHANGE, then run install again.
# The package is the same for every company: nothing here is specific to a client until you edit it.
APP_NAME="ROVEXY"
APP_PRODUCT_NAME="ROVEXY"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rovexy.example.com          # CHANGE: the https address staff and phones use for this server

# One company per install
TENANCY_MODE=fixed
TENANCY_FIXED_COMPANY_ID=1                  # set by install

# Database: MySQL / MariaDB (create an empty database and user first)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rovexy                          # CHANGE if needed
DB_USERNAME=rovexy                          # CHANGE
DB_PASSWORD=                                # CHANGE
# SQLite instead (small offices): DB_CONNECTION=sqlite and DB_DATABASE=full path of an empty .sqlite file

# No Redis needed: cache, sessions and background jobs use the database
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=true
BROADCAST_CONNECTION=null                   # live updates: the console and phones refresh on their own

# Calls go out from the phones' own SIM and Phone app
CALLING_ROUTE=sim
TELEPHONY_DRIVER=freeswitch                 # not used with CALLING_ROUTE=sim (never "simulator" in production)
MANAGEMENT_DRIVER=app_only
RECORDINGS_DRIVER=local                     # recordings are kept in rovexy\storage\app\recordings
RECORDINGS_TRANSCODE=none                   # mp3 only if ffmpeg is installed on this server
PUSH_DRIVER=fcm                             # Firebase credential arrives with the licence check-in (stored encrypted, not here); until then phones check for news themselves

# Licence — activated with the .lic file Ametecs sends for this server (activate-licence), or with a key online
LICENCE_MODE=client
LICENCE_SERVER_URL=https://rovexy.app
LICENCE_OFFLINE_DAYS=30
LICENCE_MACHINE_ID=                         # only if install says the server ID uses the host name

# Software updates (Console → Plan & licence → Check for update). Fill only if install can't find the tools.
ROVEXY_PHP_BINARY=
ROVEXY_MYSQLDUMP=
ROVEXY_MYSQL=
ROVEXY_UPDATE_AUTO_CHECK=true

LOG_CHANNEL=stack
LOG_LEVEL=info

# E-mail (password links for staff). Optional:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.yourcompany.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=rovexy@yourcompany.com
# MAIL_FROM_NAME="ROVEXY"
