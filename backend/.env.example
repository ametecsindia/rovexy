# ── ROVEXY server — environment template (NO real secrets) ──────────────
APP_NAME="ROVEXY"
APP_PRODUCT_NAME="ROVEXY"   # configurable working name
APP_ENV=production                          # local | testing | production
APP_KEY=                                    # php artisan key:generate
APP_DEBUG=false
APP_URL=https://mdm.example.com             # must be https:// in production
TRUSTED_PROXIES=                            # comma-separated load-balancer IPs/CIDRs

# Tenancy: shared (SaaS) resolves verified domain or workspace slug; fixed = on-prem single company
TENANCY_MODE=shared
TENANCY_BASE_DOMAIN=mdm.example.com         # {slug}.mdm.example.com
TENANCY_FIXED_COMPANY_ID=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ammp
DB_USERNAME=ammp
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=mdm.example.com,*.mdm.example.com   # add every verified custom company domain too

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.mdm.example.com
REVERB_PORT=443
REVERB_SCHEME=https

# Telephony: freeswitch (production) | simulator (APP_ENV=local only — refused elsewhere)
TELEPHONY_DRIVER=freeswitch
FREESWITCH_ESL_HOST=10.0.0.10
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=
FREESWITCH_GATEWAY=
FREESWITCH_CALLER_ID=
FREESWITCH_SIP_DOMAIN=
FREESWITCH_RECORDINGS_BASE=/var/lib/freeswitch/recordings
FREESWITCH_RECORDING_SOURCE=local          # local (shared mount) | http
FREESWITCH_RECORDING_HTTP_BASE=
FREESWITCH_RECORDING_HTTP_SECRET=
TELEPHONY_WEBHOOK_SECRET=

# Recordings: private local disk or S3-compatible
RECORDINGS_DRIVER=local                     # local | s3
RECORDINGS_LOCAL_ROOT=/srv/ammp/recordings
RECORDINGS_S3_BUCKET=
RECORDINGS_S3_REGION=ap-south-1
RECORDINGS_S3_ENDPOINT=
RECORDINGS_S3_KEY=
RECORDINGS_S3_SECRET=
RECORDINGS_S3_PATH_STYLE=false
RECORDINGS_TRANSCODE=mp3                    # mp3 (needs ffmpeg/ffprobe) | none

# Device management: amapi (production) | app_only (device-level controls reported as Requires Additional Setup)
MANAGEMENT_DRIVER=app_only
AMAPI_ENTERPRISE_NAME=
AMAPI_SERVICE_ACCOUNT_JSON_PATH=/etc/ammp/amapi-sa.json
AMAPI_PUBSUB_AUDIENCE=https://mdm.example.com/api/amapi/v1/notifications
AMMP_APP_PACKAGE=in.ametecs.managedmobile

# Push: fcm (production) | log (development only — refused in production)
PUSH_DRIVER=fcm
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_PATH=/etc/ammp/fcm-sa.json

# WebRTC (screen/camera sessions)
STUN_URLS=stun:turn.example.com:3478
TURN_URLS=turns:turn.example.com:5349?transport=tcp,turn:turn.example.com:3478
TURN_SHARED_SECRET=

LOG_CHANNEL=stack
LOG_LEVEL=info

# Field map: Google Maps API keys are entered in the admin console (Integrations → Google Maps). true = ETAs with live traffic (dearer).
GOOGLE_MAPS_TRAFFIC_AWARE=true
