<?xml version="1.0" encoding="UTF-8"?>
<!-- Full Laravel test suite (requires `composer install`). The framework-free domain suite is phpunit.domain.xml. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" bootstrap="vendor/autoload.php" colors="true">
    <testsuites>
        <testsuite name="Domain"><directory>tests/Domain</directory></testsuite>
        <testsuite name="Feature"><directory>tests/Feature</directory></testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="SESSION_SECURE_COOKIE" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="TELEPHONY_DRIVER" value="simulator"/>
        <env name="CALLING_ROUTE" value="server"/>
        <env name="PUSH_DRIVER" value="log"/>
        <env name="MANAGEMENT_DRIVER" value="app_only"/>
        <env name="TENANCY_MODE" value="shared"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="ADMIN_MFA_REQUIRED" value="true"/><!-- tests expect the production default, whatever the local .env says -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="LICENSE_MODE" value="cloud"/>
        <env name="RECORDINGS_LOCAL_ROOT" value="storage/framework/testing/recordings"/>
    </php>
</phpunit>
