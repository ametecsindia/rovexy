@@ -0,0 +1,68 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Http\Controllers\Platform;
+
+use App\Http\Controllers\Controller;
+use App\Models\Platform\Licence;
+use App\Models\Platform\NumberVoucher;
+use App\Services\Platform\PlatformAudit;
+use Illuminate\Http\Request;
+
+/** Super Admin → Number vouchers: company numbers for Click2Call / Smart31, redeemed once in the company's Calling configuration. */
+final class VoucherController extends Controller
+{
+    public function index(Request $r)
+    {
+        $holders = Licence::query()->pluck('holder_name', 'id');
+        return response()->json(NumberVoucher::query()->latest('id')
+            ->when($r->query('status'), fn ($q, $s) => $q->where('status', $s))
+            ->when($r->query('q'), fn ($q, $s) => $q->where(fn ($w) => $w->where('code', 'like', '%' . addcslashes($s, '%_') . '%')->orWhere('note', 'like', '%' . addcslashes($s, '%_') . '%')))
+            ->paginate(50)->through(fn (NumberVoucher $v) => $v->toArray() + [
+                'for' => $v->licence_id ? ($holders[$v->licence_id] ?? "#{$v->licence_id}") : null,
+                'used_by' => $v->used_company_id ? (\App\Models\Company::query()->whereKey($v->used_company_id)->value('name') ?? "company #{$v->used_company_id}")
+                    : ($v->used_licence_id ? ($holders[$v->used_licence_id] ?? "#{$v->used_licence_id}") : null),
+            ]));
+    }
+
+    /** Numbers are typed one per line (or comma separated); Smart31 lines may add ",1600" and ",group name". */
+    public function store(Request $r)
+    {
+        $d = $r->validate([
+            'click2call' => 'nullable|string|max:20000', 'obd' => 'nullable|string|max:20000', 'webrtc' => 'nullable|string|max:20000',
+            'verified' => 'nullable|string|max:20000', 'smart31' => 'nullable|string|max:20000',
+            'licence_id' => 'nullable|integer|exists:licences,id', 'numbers_expire_on' => 'nullable|date', 'redeem_by' => 'nullable|date',
+            'note' => 'nullable|string|max:190',
+        ]);
+        $norm = fn ($n) => \App\Telephony\Click2CallAdapter::normalize($n);
+        $list = fn (?string $s) => array_values(array_unique(array_filter(array_map($norm, preg_split('/[\s,;]+/', (string) $s)), fn ($n) => strlen($n) >= 6 && strlen($n) <= 15)));
+        [$c2c, $obd, $web, $ver] = [$list($d['click2call'] ?? ''), $list($d['obd'] ?? ''), $list($d['webrtc'] ?? ''), $list($d['verified'] ?? '')];
+        $numbers = array_map(fn ($n) => ['number' => $n, 'click2call' => in_array($n, $c2c, true), 'obd' => in_array($n, $obd, true),
+            'webrtc' => in_array($n, $web, true), 'verified' => in_array($n, $ver, true)], array_values(array_unique(array_merge($c2c, $obd, $web))));
+        $smart = [];
+        foreach (preg_split('/\R/', (string) ($d['smart31'] ?? '')) as $line) {
+            $parts = array_map('trim', explode(',', $line));
+            $n = $norm($parts[0] ?? '');
+            if (strlen($n) >= 6) {
+                $type = collect($parts)->contains('1600') || str_starts_with($n, '1600') ? '1600' : null;
+                $smart[$n] = ['number' => $n, 'type' => $type, 'group_name' => collect(array_slice($parts, 1))->first(fn ($p) => $p !== '' && $p !== '1600')];
+            }
+        }
+        abort_if(!$numbers && !$smart, 422, 'Add at least one number.');
+        $v = NumberVoucher::query()->create(['code' => NumberVoucher::newCode(), 'licence_id' => $d['licence_id'] ?? null, 'numbers' => $numbers,
+            'smart31' => array_values($smart), 'numbers_expire_on' => $d['numbers_expire_on'] ?? null, 'redeem_by' => $d['redeem_by'] ?? null,
+            'note' => $d['note'] ?? null, 'created_by' => $r->user()?->email]);
+        PlatformAudit::record('voucher.created', $v, ['code' => $v->code, 'numbers' => count($numbers), 'smart31' => count($smart)]);
+        return response()->json($v, 201);
+    }
+
+    public function cancel(int $id)
+    {
+        $v = NumberVoucher::query()->findOrFail($id);
+        abort_if($v->status !== 'new', 422, 'Only an unused voucher can be cancelled.');
+        $v->forceFill(['status' => 'cancelled'])->save();
+        PlatformAudit::record('voucher.cancelled', $v, ['code' => $v->code]);
+        return response()->json(['ok' => true]);
+    }
+}
