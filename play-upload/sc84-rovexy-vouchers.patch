+    protected function casts(): array
+    {
+        return ['numbers' => 'array', 'smart31' => 'array', 'numbers_expire_on' => 'date', 'redeem_by' => 'date', 'used_at' => 'datetime'];
+    }
+
+    public static function newCode(): string
+    {
+        do {
+            $c = 'RXV-' . strtoupper(substr(bin2hex(random_bytes(4)), 0, 4) . '-' . substr(bin2hex(random_bytes(4)), 0, 4));
+        } while (self::query()->where('code', $c)->exists());
+        return $c;
+    }
+
+    /**
+     * Redeem once (row-locked). $licence = the redeeming company's / install's licence (null = company without one).
+     * Returns the voucher's numbers in the shape the Add Voucher import reads (LeadGER did_voucher "data").
+     * @throws DomainException with a message for the admin
+     */
+    public static function redeem(string $code, ?Licence $licence, ?int $companyId, ?string $server = null): array
+    {
+        return DB::transaction(function () use ($code, $licence, $companyId, $server) {
+            $v = self::query()->where('code', strtoupper(trim($code)))->lockForUpdate()->first();
+            if (!$v || $v->status === 'cancelled') {
+                throw new DomainException('voucher_invalid', 'This voucher code is not valid. Check it, or ask Ametecs for a new one.');
+            }
+            if ($v->status === 'used') {
+                throw new DomainException('voucher_used', 'This voucher has already been used' . ($v->used_at ? ' on ' . $v->used_at->format('d M Y') : '') . '.');
+            }
+            if ($v->redeem_by && $v->redeem_by->endOfDay()->isPast()) {
+                throw new DomainException('voucher_expired', 'This voucher code expired on ' . $v->redeem_by->format('d M Y') . '. Ask Ametecs for a new one.');
+            }
+            if ($v->licence_id && $v->licence_id !== $licence?->id) {
+                throw new DomainException('voucher_other_licence', 'This voucher was issued for another ROVEXY licence.');
+            }
+            $v->forceFill(['status' => 'used', 'used_licence_id' => $licence?->id, 'used_company_id' => $companyId, 'used_by_server' => $server, 'used_at' => now()])->save();
+            $pick = fn (string $flag) => implode(',', array_column(array_filter($v->numbers, fn ($n) => !empty($n[$flag])), 'number'));
+            return [
+                'click2call_did' => $pick('click2call'), 'obd_did' => $pick('obd'), 'webrtc_did' => $pick('webrtc'), 'tc_verified' => $pick('verified'),
+                'expiry' => $v->numbers_expire_on?->toDateString(),
+                'smart_groups' => array_map(fn ($s) => ['vmn' => $s['number'], 'usage_date' => now()->toDateString(), 'c2c' => 1,
+                    'type' => $s['type'] ?? null, 'group_name' => $s['group_name'] ?? null], $v->smart31 ?? []),
+            ];
+        });
+    }
+}
