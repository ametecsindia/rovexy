+// Click2Call provider callback: one fixed URL; ref_id = our call uuid. The body is ignored — it only triggers a read from
+// the gateway. When C2C_WEBHOOK_SECRET is set it is required (Secret-Key / X-Webhook-Secret header, or ?secret=).
+Route::match(['get', 'post'], 'telephony/v1/click2call', function (\Illuminate\Http\Request $r, \App\Services\CallService $svc) {
+    $secret = (string) config('ammp.telephony.click2call.webhook_secret');
+    $given = (string) ($r->header('Secret-Key') ?? $r->header('X-Webhook-Secret') ?? $r->query('secret') ?? '');
+    abort_if($secret !== '' && !hash_equals($secret, $given), 401);
+    $ref = (string) ($r->input('ref_id') ?? $r->input('REF_ID') ?? $r->input('reference_id') ?? $r->input('refId') ?? '');
+    $ctx = app(\App\Support\CurrentCompany::class);
+    $call = $ref === '' ? null : $ctx->withoutScope(fn () => \App\Models\Call::query()->where('uuid', $ref)->where('provider', 'click2call')->first());
+    if ($call) {
+        $ctx->run(\App\Models\Company::query()->findOrFail($call->company_id), fn () => $svc->syncProvider($call));
+    }
+    return response()->json(['status' => $call ? 'success' : 'ignored']);
+})->name('telephony.click2call')->middleware('throttle:telephony');
