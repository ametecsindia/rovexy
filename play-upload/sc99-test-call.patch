+type TestState = { call_id: number; state: string; terminal: boolean; cause: string | null; talk_seconds: number; recording_status: string };
+const STATE_TEXT: Record<string, string> = {
+  initiated: 'Asking the provider to place the call…', agent_ringing: 'Your phone is ringing — answer it.', ringing: 'You answered. The customer is ringing…',
+  answered: 'Connected — talk, then hang up.', completed: 'Call completed.', busy: 'Customer was busy.', no_answer: 'Customer did not answer.',
+  agent_unanswered: 'You did not answer your phone, so the customer was not called.', disconnected: 'Customer answered but the call ended at once.', failed: 'The call failed.',
+};
+
+/** Calling options → Test call: one real Click2Call call from the console, then its result and recording. */
+function TestCall() {
+  const a = useAction();
+  const [n, setN] = useState({ agent_number: '', customer_number: '' });
+  const [msg, setMsg] = useState<{ ok: boolean; detail: string } | null>(null);
+  const [st, setSt] = useState<TestState | null>(null);
+  const waiting = !!st && (!st.terminal || ['pending', 'processing'].includes(st.recording_status));
+  useEffect(() => {
+    if (!st || !waiting) return;
+    const started = Date.now();
+    const t = setInterval(async () => {
+      if (Date.now() - started > 15 * 60 * 1000) { clearInterval(t); return; }   // ponytail: stop polling after 15 min; the call stays in Calls
+      try { setSt(await get(`/calling/click2call/test-call/${st.call_id}`)); } catch { /* next tick */ }
+    }, 4000);
+    return () => clearInterval(t);
+  }, [st?.call_id, waiting]);
+  const call = () => a.run(async () => {
+    setSt(null); setMsg(null);
+    try {
+      const r = await post('/calling/click2call/test-call', n);
+      setMsg(r);
+      setSt({ call_id: r.call_id, state: 'initiated', terminal: false, cause: null, talk_seconds: 0, recording_status: 'pending' });
+    } catch (e: any) { setMsg({ ok: false, detail: e?.message ?? String(e) }); }
+  });
+  return (
+    <Card title="Test call">
+      <p className="muted">Places one real Click2Call call: your phone rings first, then the customer number, from the company number. The result and recording show here and in Calls.</p>
+      <div className="form-grid two">
+        <label className="field"><span>Your phone (rings first)</span><input inputMode="tel" value={n.agent_number} placeholder="98XXXXXXXX" onChange={(e) => setN({ ...n, agent_number: e.target.value })} /></label>
+        <label className="field"><span>Customer number to call</span><input inputMode="tel" value={n.customer_number} placeholder="98XXXXXXXX" onChange={(e) => setN({ ...n, customer_number: e.target.value })} /></label>
+      </div>
+      {msg && <Notice tone={msg.ok ? 'ok' : 'warn'}>{msg.detail}</Notice>}
+      {st && (
+        <div style={{ display: 'flex', gap: 12, alignItems: 'center', flexWrap: 'wrap', margin: '8px 0' }}>
+          <Badge value={st.state} />
+          <span>{STATE_TEXT[st.state] ?? st.state}{st.talk_seconds > 0 ? ` Talk time ${st.talk_seconds}s.` : ''}</span>
+          {st.terminal && st.cause && <span className="code">{st.cause}</span>}
+          {st.terminal && st.talk_seconds > 0 && (st.recording_status === 'available'
+            ? <RecordingPlayer callId={st.call_id} status="available" canPlay canDownload />
+            : <span className="muted">Recording: {['pending', 'processing'].includes(st.recording_status) ? 'waiting for the provider…' : st.recording_status.replace(/_/g, ' ')}</span>)}
+        </div>
+      )}
+      <button disabled={a.busy || waiting || !n.agent_number || !n.customer_number} onClick={call}>{waiting ? 'Call in progress…' : 'Call now'}</button>
+    </Card>
+  );
+}
