diff --git a/admin/src/pages/CallingConfig.tsx b/admin/src/pages/CallingConfig.tsx
new file mode 100644
index 0000000..bf9f64d
--- /dev/null
+++ b/admin/src/pages/CallingConfig.tsx
@@ -0,0 +1,182 @@
+import { useState } from 'react';
+import { Link } from 'react-router-dom';
+import { del, get, patch, post, put } from '../lib/api';
+import { Badge, Card, ErrorBox, Notice, Page, Table, useAction, useAsync } from '../components/ui';
+
+/**
+ * Calling Configuration section. Three layers decide whether a call may use Click2Call / Smart31:
+ * the plan (licence, Administration → Plan & licence), the company switch (these pages) and who may use it (Access).
+ */
+const NAME: Record<string, string> = { click2call: 'Click2Call', smart31: 'Smart31' };
+
+function NotInPlan({ feature }: { feature: string }) {
+  return <Notice tone="warn"><strong>{NAME[feature]} is not part of your ROVEXY plan.</strong> Settings here have no effect until the plan includes it. See <Link to="/licence">Plan &amp; licence</Link>.</Notice>;
+}
+
+/** Calling Configuration → Click2Call */
+export function Click2CallPage() {
+  const cfg = useAsync(() => get('/calling/click2call'));
+  const health = useAsync(() => get('/health'));
+  const [f, setF] = useState<{ mode: string; did: string; agent_caller_id: string; gateway_secret: string } | null>(null);
+  const [result, setResult] = useState<{ ok: boolean; detail: string } | null>(null);
+  const a = useAction();
+  const d = cfg.data;
+  const v = f ?? (d ? { mode: d.mode ?? 'off', did: d.did ?? '', agent_caller_id: d.agent_caller_id ?? '', gateway_secret: '' } : null);
+  const set = (k: string, val: string) => v && setF({ ...v, [k]: val });
+  const save = () => a.run(async () => {
+    setResult(await put('/calling/click2call', { mode: v!.mode, did: v!.did || null, agent_caller_id: v!.agent_caller_id || null, gateway_secret: v!.gateway_secret || null }));
+    setF(null); await cfg.reload(); await health.reload();
+  });
+  const test = () => a.run(async () => setResult(await post('/calling/click2call/test')));
+  return (
+    <Page title="Click2Call" subtitle="The calling provider rings the employee's work phone first; when they answer, it calls the customer, who sees your company number. The provider records the call and the recording is copied here.">
+      <ErrorBox error={cfg.error ?? a.error} />
+      {d && !d.in_plan && <NotInPlan feature="click2call" />}
+      {v && (
+        <Card title="Settings" actions={d?.mode && d.mode !== 'off' ? <Badge value="active" label={d.mode === 'only' ? 'Click2Call only' : 'Employee chooses'} /> : <Badge value="off" label="Off" />}>
+          <div className="form-grid two">
+            <label className="field"><span>Calling option on the phone</span>
+              <select value={v.mode} onChange={(e) => set('mode', e.target.value)}>
+                <option value="off">Off: SIM calls only</option>
+                <option value="choice">Employee chooses SIM call or Click2Call on each call</option>
+                <option value="only">Click2Call only</option>
+              </select>
+            </label>
+            <label className="field"><span>Company number (VMN)</span><input value={v.did} placeholder="80XXXXXXXX" onChange={(e) => set('did', e.target.value)} disabled={v.mode === 'off'} /></label>
+            <label className="field"><span>Gateway secret</span><input type="password" autoComplete="new-password" value={v.gateway_secret} placeholder={d?.secret_hint ? `Stored (${d.secret_hint}). Leave blank to keep` : 'From your provider account'} onChange={(e) => set('gateway_secret', e.target.value)} disabled={v.mode === 'off'} /></label>
+            <label className="field"><span>Number the employee is rung from (optional)</span><input value={v.agent_caller_id} placeholder="Same as the company number" onChange={(e) => set('agent_caller_id', e.target.value)} disabled={v.mode === 'off'} /></label>
+          </div>
+          <p className="muted">Give your provider this callback URL for call results: <span className="code">{d?.callback_url}</span></p>
+          <p className="muted">Who may use it: <Link to="/calling/access">Access &amp; permissions</Link>. Rotating numbers: <Link to="/calling/smart31">Smart31</Link>. Each employee's work number: <Link to="/employees">Groups &amp; people</Link>.</p>
+          {result && <Notice tone={result.ok ? 'info' : 'warn'}>{result.detail}</Notice>}
+          <div style={{ display: 'flex', gap: 8 }}>
+            <button disabled={a.busy} onClick={save}>Save</button>
+            <button className="secondary" disabled={a.busy || v.mode === 'off'} onClick={test}>Test connection</button>
+          </div>
+        </Card>
+      )}
+      {health.data && (
+        <Card title="Telephony status">
+          <p>Route on the phone: <strong>{(health.data.telephony.routes ?? [health.data.telephony.route]).map((r: string) => (r === 'sim' ? 'SIM call' : 'Click2Call / server')).join(' or ')}</strong> · driver <strong>{health.data.telephony.driver}</strong> · <Badge value={health.data.telephony.ok} label={health.data.telephony.ok ? 'reachable' : 'unreachable'} /> <span className="muted">{health.data.telephony.detail}</span></p>
+          {health.data.telephony.simulated && <Notice tone="warn">SIMULATOR — development only. No real calls are placed and no audio is recorded.</Notice>}
+        </Card>
+      )}
+    </Page>
+  );
+}
+
+/** Calling Configuration → Access & permissions: who may use Click2Call and Smart31 (everyone, or selected groups/people). */
+export function CallingAccessPage() {
+  const acc = useAsync(() => get('/calling/access'));
+  const teams = useAsync(() => get<any[]>('/teams'));
+  const people = useAsync(() => get('/employees'));
+  const a = useAction();
+  const [pick, setPick] = useState<Record<string, string>>({});
+  const reload = () => acc.reload();
+  return (
+    <Page title="Access & permissions" subtitle="Choose who may use each calling feature: everyone, or only the groups and people you add here. A feature also has to be in your plan and switched on.">
+      <ErrorBox error={acc.error ?? a.error} />
+      {acc.data && Object.entries(acc.data).map(([feature, x]: [string, any]) => (
+        <Card key={feature} title={NAME[feature]} actions={<>
+          <Badge value={x.in_plan} label={x.in_plan ? 'in plan' : 'not in plan'} />{' '}
+          <Badge value={x.on ? 'active' : 'off'} label={x.on ? 'switched on' : 'switched off'} />
+        </>}>
+          {!x.in_plan && <NotInPlan feature={feature} />}
+          <label className="field"><span>Who may use {NAME[feature]}</span>
+            <select value={x.mode} disabled={a.busy} onChange={(e) => a.run(async () => { await put(`/calling/access/${feature}`, { mode: e.target.value }); await reload(); })}>
+              <option value="everyone">Everyone</option>
+              <option value="selected">Only the groups and people listed below</option>
+            </select>
+          </label>
+          {x.mode === 'selected' && (
+            <>
+              <Table rows={x.grants} empty="Nobody yet: add a group or a person." columns={[
+                { key: 'type', label: 'Type', render: (g: any) => <Badge value={g.type === 'group' ? 'active' : 'pending'} label={g.type} /> },
+                { key: 'name', label: 'Name', render: (g: any) => <>{g.name} {g.code && <small className="muted">{g.code}</small>}</> },
+                { key: 'x', label: '', render: (g: any) => <button className="ghost" disabled={a.busy} onClick={() => a.run(async () => { await del(`/calling/access/${feature}/${g.id}`); await reload(); })}>Remove</button> },
+              ]} />
+              <div className="form-grid two" style={{ marginTop: 12 }}>
+                <label className="field"><span>Add a group</span>
+                  <select value={pick[`${feature}.team`] ?? ''} onChange={(e) => setPick({ ...pick, [`${feature}.team`]: e.target.value })}>
+                    <option value="">— choose a group —</option>{(teams.data ?? []).map((t: any) => <option key={t.id} value={t.id}>{t.name}</option>)}
+                  </select>
+                </label>
+                <label className="field"><span>Add a person</span>
+                  <select value={pick[`${feature}.user`] ?? ''} onChange={(e) => setPick({ ...pick, [`${feature}.user`]: e.target.value })}>
+                    <option value="">— choose a person —</option>{(people.data?.data ?? []).map((u: any) => <option key={u.id} value={u.id}>{u.name} ({u.employee_code})</option>)}
+                  </select>
+                </label>
+              </div>
+              <button disabled={a.busy || (!pick[`${feature}.team`] && !pick[`${feature}.user`])} onClick={() => a.run(async () => {
+                await post(`/calling/access/${feature}`, { team_ids: pick[`${feature}.team`] ? [Number(pick[`${feature}.team`])] : [], user_ids: pick[`${feature}.user`] ? [Number(pick[`${feature}.user`])] : [] });
+                setPick({ ...pick, [`${feature}.team`]: '', [`${feature}.user`]: '' }); await reload();
+              })}>Add</button>
+            </>
+          )}
+        </Card>
+      ))}
+    </Page>
+  );
+}
+
+/** Calling Configuration → Smart31: the company's rotating numbers. Click2Call calls of allowed people use them in turn. */
+export function Smart31Page() {
+  const s = useAsync(() => get('/calling/smart31'));
+  const teams = useAsync(() => get<any[]>('/teams'));
+  const a = useAction();
+  const empty = { number: '', label: '', team_ids: [] as number[], expires_on: '' };
+  const [n, setN] = useState(empty);
+  const [edit, setEdit] = useState<any | null>(null);
+  const d = s.data;
+  const groupsSelect = (val: number[], on: (v: number[]) => void) => (
+    <select multiple value={val.map(String)} style={{ minHeight: 70 }} onChange={(e) => on(Array.from(e.target.selectedOptions).map((o) => Number(o.value)))}>
+      {(teams.data ?? []).map((t: any) => <option key={t.id} value={t.id}>{t.name}</option>)}
+    </select>
+  );
+  return (
+    <Page title="Smart31 numbers" subtitle="Smart31 spreads Click2Call calls over several company numbers, one after another (round-robin), so no single number gets tagged as spam. A number limited to groups is used only for those groups' calls.">
+      <ErrorBox error={s.error ?? a.error} />
+      {d && !d.in_plan && <NotInPlan feature="smart31" />}
+      {d && d.in_plan && !d.click2call_on && <Notice tone="warn">Smart31 numbers are used for Click2Call calls. <Link to="/calling/click2call">Switch on Click2Call</Link> first.</Notice>}
+      {d && (
+        <Card title="Rotation" actions={<Badge value={d.enabled ? 'active' : 'off'} label={d.enabled ? 'On' : 'Off'} />}>
+          <p className="muted">When on, every Click2Call call by someone allowed Smart31 (<Link to="/calling/access">Access &amp; permissions</Link>) goes out on the next number in the pool. Otherwise the Click2Call company number is used.</p>
+          <button disabled={a.busy || !d.in_plan} onClick={() => a.run(async () => { await put('/calling/smart31', { enabled: !d.enabled }); await s.reload(); })}>{d.enabled ? 'Switch off' : 'Switch on'}</button>
+        </Card>
+      )}
+      {d && (
+        <Card title={`Numbers in the pool (${d.numbers.length})`}>
+          <Table rows={d.numbers} empty="No numbers yet." columns={[
+            { key: 'number', label: 'Number', render: (x: any) => <strong>{x.number}</strong> },
+            { key: 'label', label: 'Label' },
+            { key: 'groups', label: 'Groups', render: (x: any) => x.groups.length ? x.groups.join(', ') : <span className="muted">All groups</span> },
+            { key: 'calls', label: 'Calls', render: (x: any) => x.calls },
+            { key: 'last', label: 'Last used', render: (x: any) => x.last_used_at ? new Date(x.last_used_at).toLocaleString() : '—' },
+            { key: 'state', label: 'State', render: (x: any) => x.expired ? <Badge value="failed" label="expired" /> : <Badge value={x.active ? 'active' : 'off'} label={x.active ? 'in use' : 'paused'} /> },
+            { key: 'x', label: '', render: (x: any) => <span style={{ display: 'flex', gap: 6 }}>
+              <button className="ghost" disabled={a.busy || !d.in_plan} onClick={() => setEdit({ ...x, expires_on: x.expires_on?.slice(0, 10) ?? '', team_ids: x.team_ids ?? [] })}>Edit</button>
+              <button className="ghost" disabled={a.busy || !d.in_plan} onClick={() => a.run(async () => { await patch(`/calling/smart31/numbers/${x.id}`, { active: !x.active }); await s.reload(); })}>{x.active ? 'Pause' : 'Resume'}</button>
+              <button className="ghost" disabled={a.busy} onClick={() => a.run(async () => { await del(`/calling/smart31/numbers/${x.id}`); await s.reload(); })}>Remove</button>
+            </span> },
+          ]} />
+        </Card>
+      )}
+      {d?.in_plan && (
+        <Card title={edit ? `Edit ${edit.number}` : 'Add a number'}>
+          <div className="form-grid two">
+            <label className="field"><span>Number</span><input value={edit ? edit.number : n.number} placeholder="1600XXXXXX or 80XXXXXXXX" onChange={(e) => (edit ? setEdit({ ...edit, number: e.target.value }) : setN({ ...n, number: e.target.value }))} /></label>
+            <label className="field"><span>Label (optional)</span><input value={edit ? edit.label ?? '' : n.label} placeholder="e.g. 1600 series / Hyderabad" onChange={(e) => (edit ? setEdit({ ...edit, label: e.target.value }) : setN({ ...n, label: e.target.value }))} /></label>
+            <label className="field"><span>Only for these groups (none = all groups; Ctrl+click for several)</span>{groupsSelect(edit ? edit.team_ids : n.team_ids, (v) => (edit ? setEdit({ ...edit, team_ids: v }) : setN({ ...n, team_ids: v })))}</label>
+            <label className="field"><span>Expires on (optional)</span><input type="date" value={edit ? edit.expires_on : n.expires_on} onChange={(e) => (edit ? setEdit({ ...edit, expires_on: e.target.value }) : setN({ ...n, expires_on: e.target.value }))} /></label>
+          </div>
+          <div style={{ display: 'flex', gap: 8 }}>
+            {edit ? <>
+              <button disabled={a.busy} onClick={() => a.run(async () => { await patch(`/calling/smart31/numbers/${edit.id}`, { number: edit.number, label: edit.label || null, team_ids: edit.team_ids, expires_on: edit.expires_on || null }); setEdit(null); await s.reload(); })}>Save changes</button>
+              <button className="secondary" onClick={() => setEdit(null)}>Cancel</button>
+            </> : <button disabled={a.busy || !n.number} onClick={() => a.run(async () => { await post('/calling/smart31/numbers', { number: n.number, label: n.label || null, team_ids: n.team_ids, expires_on: n.expires_on || null }); setN(empty); await s.reload(); })}>Add number</button>}
+          </div>
+        </Card>
+      )}
+    </Page>
+  );
+}
