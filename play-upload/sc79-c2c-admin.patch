+/** Calling → Configuration: Click2Call for this company (provider rings the employee's work number, then the customer). */
+function Click2CallCard({ onSaved }: { onSaved: () => void }) {
+  const cfg = useAsync(() => get('/calling/click2call'));
+  const [f, setF] = useState<{ mode: string; did: string; agent_caller_id: string; gateway_secret: string } | null>(null);
+  const [result, setResult] = useState<{ ok: boolean; detail: string } | null>(null);
+  const a = useAction();
+  const d = cfg.data;
+  const v = f ?? (d ? { mode: d.mode ?? 'off', did: d.did ?? '', agent_caller_id: d.agent_caller_id ?? '', gateway_secret: '' } : null);
+  if (!v) return <Card title="Click2Call"><ErrorBox error={cfg.error} /></Card>;
+  const set = (k: string, val: string) => setF({ ...v, [k]: val });
+  const save = () => a.run(async () => {
+    setResult(await put('/calling/click2call', { mode: v.mode, did: v.did || null, agent_caller_id: v.agent_caller_id || null, gateway_secret: v.gateway_secret || null }));
+    setF(null); await cfg.reload(); onSaved();
+  });
+  const test = () => a.run(async () => setResult(await post('/calling/click2call/test')));
+  return (
+    <Card title="Click2Call" actions={d?.mode && d.mode !== 'off' ? <Badge value="active" label={d.mode === 'only' ? 'Click2Call only' : 'Employee chooses'} /> : <Badge value="off" label="Off" />}>
+      <p className="muted">The calling provider rings the employee's <strong>work phone number</strong> first; when they answer, it calls the customer, who sees your company number (VMN). The provider records the call and the recording is copied here. Set each employee's work number, and who may use Click2Call, under <Link to="/employees">People, groups &amp; roles</Link>.</p>
+      <ErrorBox error={a.error} />
+      <div className="form-grid two">
+        <label className="field"><span>Calling option on the phone</span>
+          <select value={v.mode} onChange={(e) => set('mode', e.target.value)}>
+            <option value="off">Off: SIM calls only</option>
+            <option value="choice">Employee chooses SIM call or Click2Call on each call</option>
+            <option value="only">Click2Call only</option>
+          </select>
+        </label>
+        <label className="field"><span>Company number (VMN)</span><input value={v.did} placeholder="80XXXXXXXX" onChange={(e) => set('did', e.target.value)} disabled={v.mode === 'off'} /></label>
+        <label className="field"><span>Gateway secret</span><input type="password" autoComplete="new-password" value={v.gateway_secret} placeholder={d?.secret_hint ? `Stored (${d.secret_hint}). Leave blank to keep` : 'From your provider account'} onChange={(e) => set('gateway_secret', e.target.value)} disabled={v.mode === 'off'} /></label>
+        <label className="field"><span>Number the employee is rung from (optional)</span><input value={v.agent_caller_id} placeholder="Same as the VMN" onChange={(e) => set('agent_caller_id', e.target.value)} disabled={v.mode === 'off'} /></label>
+      </div>
+      <p className="muted">Give your provider this callback URL for call results: <span className="code">{d?.callback_url}</span>{d?.staff_without_c2c ? ` · ${d.staff_without_c2c} employee(s) are not allowed Click2Call.` : ''}</p>
+      {result && <Notice tone={result.ok ? 'info' : 'warn'}>{result.detail}</Notice>}
+      <div style={{ display: 'flex', gap: 8 }}>
+        <button disabled={a.busy} onClick={save}>Save</button>
+        <button className="secondary" disabled={a.busy || v.mode === 'off'} onClick={test}>Test connection</button>
+      </div>
+    </Card>
+  );
+}
